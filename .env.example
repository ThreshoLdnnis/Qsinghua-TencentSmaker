# 本地配置示例；自己的 Key 仅放入 .env。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOKENS=800
LLM_THINKING=disabled
RUNTIME_MAX_STEPS=8
RUNTIME_MAX_CONTEXT_CHARS=48000
RUNTIME_MAX_REQUESTS_PER_SESSION=500

# 外部调用统一调度。修改并发与队列配置后重启服务。
EXTERNAL_MAX_CONCURRENT=4
EXTERNAL_MAX_QUEUE=16
EXTERNAL_QUEUE_TIMEOUT_SECONDS=5
LLM_MAX_CONCURRENT=2

# 语音转写。配置后重启服务。凭据只放本地 .env。
ASR_PROVIDER=disabled
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_TOKEN=
ASR_ENGINE=16k_zh
ASR_TIMEOUT_SECONDS=20
ASR_MAX_CONCURRENT=2
ASR_MAX_REQUESTS=100
ASR_CACHE_SECONDS=600

# 持续支持流程。固定脚本演示不访问模型；真实模型需明确关闭demo。
PSYCHOLOGY_ENABLED=false
PSYCHOLOGY_DEMO_MODE=false
PSYCHOLOGY_DEMO_ROUTE=routine_support
ANALYSIS_TIMEZONE=Asia/Shanghai

# Public product API (app.product.main:create_app --factory), one worker only.
# Local development: COOKIE_SECURE=false and origin must exactly match the Next URL.
# Production: HTTPS origin + COOKIE_SECURE=true; never publish app.main directly.
PRODUCT_ORIGIN=http://127.0.0.1:3000
PRODUCT_COOKIE_SECURE=false
PRODUCT_DATA_DIR=data/product
PSYCHOLOGY_REQUIRE_UNDERSTANDING=true
