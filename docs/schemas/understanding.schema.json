{
  "$defs": {
    "EvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "wearable_record",
            "user_report",
            "understanding",
            "consent"
          ],
          "title": "Kind",
          "type": "string"
        },
        "source_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "source_id",
        "revision"
      ],
      "title": "EvidenceReference",
      "type": "object"
    },
    "ReflectionFields": {
      "additionalProperties": false,
      "description": "Editable hypotheses, including the user's reported facts; never a diagnosis.",
      "properties": {
        "facts": {
          "maxLength": 1000,
          "title": "Facts",
          "type": "string"
        },
        "interpretation": {
          "maxLength": 1000,
          "title": "Interpretation",
          "type": "string"
        },
        "emotions": {
          "maxLength": 1000,
          "title": "Emotions",
          "type": "string"
        },
        "needs": {
          "maxLength": 1000,
          "title": "Needs",
          "type": "string"
        }
      },
      "required": [
        "facts",
        "interpretation",
        "emotions",
        "needs"
      ],
      "title": "ReflectionFields",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "understanding.v0.1",
      "default": "understanding.v0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "understanding_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Understanding Id",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "status": {
      "enum": [
        "proposed",
        "confirmed",
        "rejected",
        "invalidated"
      ],
      "title": "Status",
      "type": "string"
    },
    "interpretation": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Interpretation",
      "type": "string"
    },
    "fields": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReflectionFields"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "origin": {
      "enum": [
        "agent_hypothesis",
        "user_report"
      ],
      "title": "Origin",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/EvidenceReference"
      },
      "maxItems": 200,
      "minItems": 1,
      "title": "Evidence Refs",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "confirmed_revision": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confirmed Revision"
    },
    "confirmed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confirmed At"
    },
    "invalidation_reason": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Invalidation Reason"
    }
  },
  "required": [
    "understanding_id",
    "revision",
    "status",
    "interpretation",
    "origin",
    "evidence_refs",
    "created_at",
    "updated_at"
  ],
  "title": "Understanding",
  "type": "object"
}
